{
  "name": "@kubohiroya/turbowarp-extended-notification",
  "version": "0.1.0",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "check": "pnpm run typecheck && npm run lint && pnpm run test && npm run build && npm run docs:check",
    "check:dist": "pnpm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.1.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.14"
  }
}
