{
  "name": "@kubohiroya/turbowarp-extended-notification",
  "version": "0.1.1",
  "description": "A TurboWarp extension for waiting on custom notifications or key presses with optional timeouts.",
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "notification"
  ],
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extended-notification.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-extended-notification/issues"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-extended-notification/",
  "type": "module",
  "files": [
    "dist/extended-notification.js",
    "docs/specification.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "audit": "pnpm audit",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run audit && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && git diff --exit-code -- dist",
    "prepublishOnly": "pnpm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.3.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
