{
  "name": "turbowarp-extended-notification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "npm run docs && git diff --exit-code -- README.md",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run docs:check",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@kubohiroya/vite-plugin-turbowarp-extension": "github:kubohiroya/vite-plugin-turbowarp-extension#a96b1ad92a5b9954d99c68b5e4a318c0722ec9e6",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.14"
  }
}
